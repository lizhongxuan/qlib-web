# 应用配置
APP_NAME=Qlib Web Console API
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development

# API配置
API_V1_PREFIX=/api/v1
SECRET_KEY=qlib-web-console-super-secret-key-for-jwt-tokens-2024-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# 前端URL配置
FRONTEND_URL=http://localhost:3000

# 数据库配置 (使用MySQL)
DATABASE_URL=mysql+pymysql://root:lzx234258@localhost:3306/qlib_web?charset=utf8mb4
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis配置 (可选，如果没有Redis服务器可以注释掉)
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600

# Celery配置 (可选，如果没有Redis服务器可以注释掉)
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Qlib配置
QLIB_DATA_PATH=/Users/zhongxuan/.qlib/qlib_data/cn_data
QLIB_REGION=cn
QLIB_PROVIDER_URI=~/.qlib/qlib_data/cn_data

# 文件存储配置
UPLOAD_PATH=./uploads
RESULTS_PATH=./results
EXPERIMENTS_PATH=./experiments
BACKUP_PATH=./backups
MAX_FILE_SIZE=100MB

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# CORS配置
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
ALLOWED_METHODS=["GET","POST","PUT","DELETE","OPTIONS"]
ALLOWED_HEADERS=["*"]

# 监控配置
ENABLE_METRICS=true
METRICS_PORT=8001

# 邮件配置 (可选)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@qlib-web.com
SMTP_FROM_NAME=Qlib Web Platform