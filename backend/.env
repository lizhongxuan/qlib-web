# 应用配置
APP_NAME=Qlib Web Console API
APP_VERSION=1.0.0
DEBUG=True
ENVIRONMENT=development

# API配置
API_V1_PREFIX=/api/v1
SECRET_KEY=qlib-web-console-secret-key-development-only-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30

# 数据库配置 (使用PostgreSQL)
DATABASE_URL=postgresql://qlib_user:qlib_password@localhost:5432/qlib_web
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis配置 (开发环境可选)
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600

# Celery配置
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Qlib配置
QLIB_DATA_PATH=/Users/zhongxuan/qlib-data/cn_data
QLIB_REGION=cn
QLIB_PROVIDER_URI=/Users/zhongxuan/qlib-data/cn_data

# 文件存储
UPLOAD_PATH=./uploads
RESULTS_PATH=./results
MAX_FILE_SIZE=100MB

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# CORS配置
ALLOWED_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]
ALLOWED_METHODS=["GET", "POST", "PUT", "DELETE", "OPTIONS"]
ALLOWED_HEADERS=["*"]

# 监控配置
ENABLE_METRICS=True
METRICS_PORT=8001