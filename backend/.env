# 应用配置
APP_NAME=Qlib Web Console API
APP_VERSION=1.0.0
DEBUG=True
ENVIRONMENT=development

# API配置
API_V1_PREFIX=/api/v1
SECRET_KEY=qlib-web-super-secure-secret-key-for-jwt-tokens-production-ready-key
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# 前端URL配置
FRONTEND_URL=http://localhost:3000

# 数据库配置
DATABASE_URL=mysql+pymysql://root:lzx234258@localhost:3306/qlib_web?charset=utf8mb4
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis配置
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600

# Qlib配置
QLIB_DATA_PATH=/Users/zhongxuan/.qlib/qlib_data/cn_data
QLIB_REGION=cn
QLIB_PROVIDER_URI=~/.qlib/qlib_data/cn_data

# 文件存储配置
UPLOAD_PATH=./uploads
RESULTS_PATH=./results
EXPERIMENTS_PATH=./experiments
BACKUP_PATH=./backups
MAX_FILE_SIZE=100MB

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# CORS配置（使用JSON格式）
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173"]

# 监控配置
ENABLE_METRICS=True
METRICS_PORT=8001

# 邮件配置
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@qlib-web.com
SMTP_FROM_NAME=Qlib Web Platform
EOF < /dev/null