# 优化的 Qlib Web Frontend Dockerfile
# 使用多阶段构建优化镜像大小和构建性能

# 阶段1：依赖安装
FROM node:18-alpine as deps

# 设置工作目录
WORKDIR /app

# 安装构建工具和依赖
RUN apk add --no-cache libc6-compat python3 make g++

# 复制依赖文件
COPY package.json package-lock.json ./

# 安装依赖 - 使用npm ci以确保可重复构建
RUN npm ci --frozen-lockfile && npm cache clean --force

# 阶段2：构建阶段
FROM node:18-alpine as builder

WORKDIR /app

# 从deps阶段复制node_modules
COPY --from=deps /app/node_modules ./node_modules

# 复制源代码
COPY . .

# 构建应用
ENV NODE_ENV=production
RUN npm run build

# 阶段3：运行时nginx阶段  
FROM nginx:1.25-alpine as runtime

# 创建非root用户
RUN addgroup -g 1001 -S nginx-user && \
    adduser -S nginx-user -u 1001

# 安装安全更新
RUN apk add --no-cache --upgrade ca-certificates

# 复制自定义nginx配置
COPY nginx.conf /etc/nginx/nginx.conf
COPY nginx-security.conf /etc/nginx/conf.d/security.conf

# 从构建阶段复制静态文件
COPY --from=builder --chown=nginx-user:nginx-user /app/dist /usr/share/nginx/html

# 创建nginx运行目录
RUN mkdir -p /var/cache/nginx /var/run/nginx && \
    chown -R nginx-user:nginx-user /var/cache/nginx /var/run/nginx /etc/nginx /usr/share/nginx/html

# 设置权限
RUN chmod -R 755 /usr/share/nginx/html && \
    find /usr/share/nginx/html -type f -exec chmod 644 {} \;

# 创建健康检查脚本
RUN echo '#!/bin/sh' > /healthcheck.sh && \
    echo 'curl -f http://localhost:80/ || exit 1' >> /healthcheck.sh && \
    chmod +x /healthcheck.sh

# 切换到非root用户
USER nginx-user

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD /healthcheck.sh

# 暴露端口
EXPOSE 80

# 启动nginx（非daemon模式）
CMD ["nginx", "-g", "daemon off;"]

# 添加元数据标签
LABEL maintainer="qlib-web-team" \
      version="1.0.0" \
      description="Qlib Web Frontend - Optimized Production Build" \
      org.opencontainers.image.source="https://github.com/your-org/qlib-web" \
      org.opencontainers.image.documentation="https://docs.qlib-web.com" \
      org.opencontainers.image.licenses="Apache-2.0"