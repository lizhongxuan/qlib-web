# Qlib Web 环境配置示例文件
# 复制此文件为 .env 并修改相应的值

# 应用基础配置
APP_NAME=Qlib Web
VERSION=1.0.0
ENVIRONMENT=production
DEBUG=false
SECRET_KEY=your-very-secure-secret-key-change-in-production

# 数据库配置
POSTGRES_DB=qlib_web
POSTGRES_USER=qlib_user
POSTGRES_PASSWORD=your_secure_database_password
POSTGRES_REPL_USER=repl_user
POSTGRES_REPL_PASSWORD=your_replication_password

# Redis 配置
REDIS_PASSWORD=your_secure_redis_password

# 日志配置
LOG_LEVEL=INFO

# 外部服务配置
SENTRY_DSN=https://your-sentry-dsn-here@sentry.io/project-id

# 监控配置
GRAFANA_ADMIN_PASSWORD=admin_secure_password

# 构建信息
BUILD_DATE=2024-08-08T12:00:00Z

# SMTP 邮件配置（可选）
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-email-password
SMTP_TLS=true

# 企业微信通知配置（可选）
WECHAT_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=your-key

# SSL 证书配置（生产环境）
SSL_CERT_PATH=./nginx/ssl/cert.pem
SSL_KEY_PATH=./nginx/ssl/key.pem

# 备份配置
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 2 * * *"
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=your-backup-bucket
BACKUP_S3_ACCESS_KEY=your-s3-access-key
BACKUP_S3_SECRET_KEY=your-s3-secret-key

# 性能配置
MAX_WORKERS=4
CELERY_CONCURRENCY=4
CELERY_MAX_TASKS_PER_CHILD=1000

# 安全配置
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# 缓存配置
CACHE_TTL=3600
REDIS_MAX_CONNECTIONS=50

# 文件存储配置
UPLOAD_MAX_SIZE=100MB
STATIC_ROOT=/var/www/static
MEDIA_ROOT=/var/www/media